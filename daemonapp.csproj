<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>


    <ItemGroup>
        <Compile Remove="apps\AutomationsApp\**" />
        <Compile Remove="apps\Common\**" />
        <Compile Remove="apps\NotificationManager\**" />
        <Compile Remove="NetDaemonApps.Tests\**" />
        <Compile Remove="Niemand.Tests\**" />
        <Compile Remove="tests\**" />
        <EmbeddedResource Remove="apps\AutomationsApp\**" />
        <EmbeddedResource Remove="apps\Common\**" />
        <EmbeddedResource Remove="apps\NotificationManager\**" />
        <EmbeddedResource Remove="NetDaemonApps.Tests\**" />
        <EmbeddedResource Remove="Niemand.Tests\**" />
        <EmbeddedResource Remove="tests\**" />
        <None Remove="apps\AutomationsApp\**" />
        <None Remove="apps\Common\**" />
        <None Remove="apps\NotificationManager\**" />
        <None Remove="NetDaemonApps.Tests\**" />
        <None Remove="Niemand.Tests\**" />
        <None Remove="tests\**" />
    </ItemGroup>
    <ItemGroup>
        <!--<PackageReference Include="AutomationPipelines" Version="0.2.0" />-->
        <PackageReference Include="CodeCasa.NetDaemon.Extensions.Observables" Version="1.4.4" />
        <PackageReference Include="Humanizer.Core" Version="3.0.1" />
        <PackageReference Include="NetDaemon.AppModel" Version="25.45.1" />
        <PackageReference Include="NetDaemon.Extensions.Logging" Version="25.45.1" />
        <PackageReference Include="NetDaemon.Extensions.Mqtt" Version="25.45.1" />
        <PackageReference Include="NetDaemon.Extensions.Scheduling" Version="25.45.1" />
        <PackageReference Include="NetDaemon.Extensions.Tts" Version="25.45.1" />
        <PackageReference Include="NetDaemon.HassModel" Version="25.45.1" />
        <PackageReference Include="NetDaemon.HassModel.Integration" Version="25.45.1" />
        <PackageReference Include="NetDaemon.Runtime" Version="25.45.1" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Microsoft.Reactive.Testing" Version="6.1.0" />
        <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
        <PackageReference Include="Polly" Version="8.6.4" />
        <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
        <PackageReference Include="stateless" Version="5.20.0" />
        <PackageReference Include="System.Reactive" Version="6.1.0" />
    </ItemGroup>
    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="apps\AlexaConfig.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <None Include="apps\**\*.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <None Remove=".gitattributes" />
        <None Remove=".gitignore" />
        <None Remove="Deploy-NetDaemon.ps1" />
        <None Remove="Dockerfile" />
        <None Remove="hacs.json" />
        <None Remove="LICENSE" />
        <None Remove="README.md" />
    </ItemGroup>
    <ItemGroup>
      <None Update="apps\LightsManager\LightsManager.yaml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
